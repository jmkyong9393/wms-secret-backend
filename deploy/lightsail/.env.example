# deploy/lightsail/.env — 서버에서 이 파일을 복사해 실제 값을 채운다. 절대 커밋하지 말 것.
#
# 기존 k8s Secret(wms-secret)에 있던 값들을 그대로 옮긴다.
# 값 목록이 기억나지 않으면: kubectl get secret wms-secret -o yaml (base64 디코딩)

# --- 이미지 공급 ---
# 공개 레포이므로 계정 ID는 여기(비커밋 파일)에만 둔다
ECR_REGISTRY=<AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- DB ---
POSTGRES_PASSWORD=<강한 비밀번호로 교체>

# --- 애플리케이션 (기존 .env / k8s Secret에서 이관) ---
SECRET_KEY=
OPENAI_API_KEY=
ALADIN_TTB_KEY=

# S3 / CloudFront (그대로 유지되는 부분)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# 프론트가 공개 주소를 알아야 하는 경우
FRONTEND_ORIGIN=https://nexus-wms.p-e.kr
WORKER_CONCURRENCY=2

# 가입 초대코드·기타 (기존 .env에서 이관)
MASTER_INVITATION_CODE=
WORKER_INVITATION_CODE=
ENV_MODE=production
